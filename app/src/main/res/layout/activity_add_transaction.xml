<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_mint_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- ========================= -->
        <!-- HEADER WITH BACK BUTTON   -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_nova_card"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/nova_text_black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="MANAGE YOUR MONEY"
                    android:textAllCaps="true"
                    android:textColor="@color/nova_mint_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Add Transaction"
                    android:textColor="@color/nova_text_black"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ========================= -->
        <!-- TRANSACTION TYPE TOGGLE   -->
        <!-- ========================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.06"
            android:text="TRANSACTION TYPE"
            android:textAllCaps="true"
            android:textColor="@color/nova_mint_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/typeToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpense"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Expense ↗"
                android:textColor="@color/nova_text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/nova_dark_pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncome"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Income ↙"
                android:textColor="@color/nova_text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/nova_dark_pill" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ========================= -->
        <!-- AMOUNT INPUT              -->
        <!-- ========================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.06"
            android:text="AMOUNT"
            android:textAllCaps="true"
            android:textColor="@color/nova_mint_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter amount"
            app:boxBackgroundColor="@color/nova_card_white"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxStrokeColor="@color/nova_dark_pill"
            app:prefixText="₹ "
            app:prefixTextColor="@color/nova_text_black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="numberDecimal"
                android:textColor="@color/nova_text_black"
                android:textSize="20sp"
                android:textStyle="bold" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- CATEGORY DROPDOWN         -->
        <!-- ========================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="CATEGORY"
            android:textAllCaps="true"
            android:textColor="@color/nova_mint_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Select category"
            app:boxBackgroundColor="@color/nova_card_white"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxStrokeColor="@color/nova_dark_pill"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/nova_text_black">

            <AutoCompleteTextView
                android:id="@+id/actCategory"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/nova_text_black"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- DATE PICKER               -->
        <!-- ========================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="DATE"
            android:textAllCaps="true"
            android:textColor="@color/nova_mint_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Transaction date"
            app:boxBackgroundColor="@color/nova_card_white"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxStrokeColor="@color/nova_dark_pill"
            app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/nova_text_black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:clickable="true"
                android:focusable="true"
                android:inputType="text"
                android:textColor="@color/nova_text_black"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- NOTE INPUT                -->
        <!-- ========================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="NOTE"
            android:textAllCaps="true"
            android:textColor="@color/nova_mint_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="What was this transaction for?"
            app:boxBackgroundColor="@color/nova_card_white"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxStrokeColor="@color/nova_dark_pill">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingTop="14dp"
                android:textColor="@color/nova_text_black"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- SAVE BUTTON (Black Pill)  -->
        <!-- ========================= -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Save Transaction"
            android:textAllCaps="false"
            android:textColor="@color/nova_text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/nova_dark_pill"
            app:cornerRadius="26dp"
            app:elevation="4dp" />

    </LinearLayout>

</ScrollView>