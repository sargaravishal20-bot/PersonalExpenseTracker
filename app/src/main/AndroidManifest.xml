<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logopersonal"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logopersonal"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalExpenseTracker">

        <!-- 1. SPLASH SCREEN (Ab yeh pehle khulegi) -->
        <activity
            android:name=".activity_splash"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. MAIN DASHBOARD -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. ADD TRANSACTION -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity_profile"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>